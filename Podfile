# iOS 최소 버전 설정 (예: iOS 14.0)
platform :ios, '14.0'

# Swift 모듈 문제 해결을 위한 옵션
use_modular_headers!

target 'PetPath' do
  pod 'Alamofire'
  pod 'DropDown'
  pod 'SnapKit'
  pod 'Firebase'  
  pod 'FirebaseMessaging'
  pod 'Moya'
  pod 'Then'
  pod 'Kingfisher'
  pod 'Socket.IO-Client-Swift'
  pod 'Starscream', '4.0.4'

  # GoogleUtilities에 modular_headers 설정 추가
  pod 'GoogleUtilities', :modular_headers => true
end